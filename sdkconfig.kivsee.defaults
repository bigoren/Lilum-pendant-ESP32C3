# Kivsee-variant sdkconfig override, layered on top of sdkconfig.defaults via
# IDF's SDKCONFIG_DEFAULTS (see board_build.cmake_extra_args in platformio.ini).
# Last file wins, so these override the BLE-on baseline.

# BLE disabled for this variant — it uses WiFi instead and must not link the
# BT/NimBLE stack (saves flash + frees the BT controller RAM).
# CONFIG_BT_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set

# Run at 80 MHz — halves dynamic CPU power.
CONFIG_ESP32C3_DEFAULT_CPU_FREQ_MHZ=80
