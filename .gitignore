# PlatformIO
.pio/

# ESP-IDF build output
build/

# VS Code
.vscode/

# Build/upload logs
build_output.txt
build_result*.txt
build_verbose.txt
upload_result.txt

# Generated sdkconfig — regenerated by ESP-IDF on every build.
# Keep the *.defaults override files tracked as the source of truth; ignore
# the generated per-env sdkconfig.<env> outputs.
sdkconfig
sdkconfig.*
!sdkconfig.defaults
!sdkconfig.*.defaults

# Claude Code harness artifacts (scheduled-task locks, etc.)
.claude/

# Secrets for the kivsee variant — copy secrets_template.h to secrets.h.
include/secrets.h

# Per-device SPIFFS data (thing name, etc.) for the kivsee variant. Each device
# has its own name; don't sync via repo. Ignore all data/* but keep the
# committed thing_info.example template. (Ignoring `data/` instead of `data/*`
# would suppress this exception — git's directory-exclude blocks re-inclusion.)
data/*
!data/thing_info.example

# CMake (root-level, generated by ESP-IDF)
CMakeLists.txt

# ESP-IDF Component Manager lockfile — auto-generated byproduct.
# The IDF/platform version is pinned in platformio.ini instead.
dependencies.lock
